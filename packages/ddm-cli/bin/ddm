import * as fs from "node:fs";
import * as path from "node:path";
import * as os from "node:os";
function readFileSafe(p2) {
  try {
    return fs.readFileSync(p2, "utf8");
  } catch {
    return null;
  }
}
function walkDir(dir, ext) {
  const results = [];
  if (!fs.existsSync(dir))
    return results;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      results.push(...walkDir(full, ext));
    } else if (entry.isFile() && entry.name.endsWith(ext)) {
      results.push(full);
    }
  }
  return results;
}
function resolveOpencodeConfig(baseDir = process.cwd()) {
  let cur = baseDir;
  for (;; ) {
    const candidate = path.join(cur, ".opencode", "opencode.jsonc");
    if (fs.existsSync(candidate))
      return candidate;
    const parent = path.dirname(cur);
    if (parent === cur)
      break;
    cur = parent;
  }
  const dir = path.join(process.cwd(), ".opencode");
  fs.mkdirSync(dir, { recursive: true });
  return path.join(dir, "opencode.jsonc");
}
function mergeJsonc(filePath, patch) {
  let raw = readFileSafe(filePath) ?? "{}";
  raw = raw.replace(/\/\/[^\n]*/g, "");
  let obj;
  try {
    obj = JSON.parse(raw);
  } catch {
    obj = {};
  }
  patch(obj);
  fs.writeFileSync(filePath, JSON.stringify(obj, null, 2), "utf8");
}
async function runCommand(cmd) {
  const { spawnSync } = await import("node:child_process");
  const [bin, ...args] = cmd.split(" ");
  const result = spawnSync(bin, args, { stdio: "inherit" });
  if (result.error)
    return { ok: false, stderr: result.error.message };
  return { ok: result.status === 0, stderr: "" };
}
async function cmdPack(opts) {
  Ge("DDM Pack");
  const agentDir = path.resolve(opts.agentDir);
  if (!fs.existsSync(agentDir)) {
    T2.error(`目录不存在: ${agentDir}`);
    process.exitCode = 1;
    return;
  }
  const s = J2();
  s.start("扫描 agent 文件...");
  const agentMdDir = path.join(agentDir, "agent");
  const agentFiles = walkDir(agentMdDir, ".md").map((f3) => path.relative(agentDir, f3).replace(/\\/g, "/"));
  if (agentFiles.length === 0) {
    s.stop("未找到 agent 定义文件", 1);
    T2.error(`在 ${agentMdDir} 下没有找到任何 .md 文件`);
    T2.info("agent 定义文件应放在 <agent-dir>/agent/<name>.md");
    process.exitCode = 1;
    return;
  }
  s.stop(`找到 ${agentFiles.length} 个 agent 文件`);
  const manifestPath = path.join(agentDir, "manifest.json");
  let manifest;
  if (fs.existsSync(manifestPath)) {
    T2.info("使用已有 manifest.json");
    try {
      manifest = parseManifest(fs.readFileSync(manifestPath, "utf8"));
    } catch (e2) {
      T2.error(String(e2));
      process.exitCode = 1;
      return;
    }
    manifest.agents = agentFiles;
  } else {
    T2.info("未找到 manifest.json，根据 agent 文件自动生成草稿");
    manifest = await generateManifestDraft(agentDir, agentFiles);
    fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2), "utf8");
    T2.warn(`已生成 manifest.json 草稿到 ${manifestPath}，请检查并补全后重新运行 ddm pack`);
    process.exitCode = 0;
    return;
  }
  const s2 = J2();
  s2.start("打包 zip...");
  const zip = new import_jszip.default;
  zip.file("manifest.json", JSON.stringify(manifest, null, 2));
  for (const rel of agentFiles) {
    const content = fs.readFileSync(path.join(agentDir, rel), "utf8");
    zip.file(rel, content);
  }
  const outName = opts.out ?? `${manifest.packageId.replace(/\./g, "-")}-${manifest.version}.zip`;
  const outPath = path.resolve(outName);
  const buf = await zip.generateAsync({ type: "nodebuffer", compression: "DEFLATE" });
  fs.writeFileSync(outPath, buf);
  s2.stop(`已生成: ${outPath}`);
  T2.info(`\uD83D\uDCE6 包 ID : ${manifest.packageId}`);
  T2.info(`\uD83D\uDCCC 版本  : ${manifest.version}`);
  T2.info(`\uD83E\uDD16 Agent : ${agentFiles.join(", ")}`);
  if (manifest.dependencies.skills?.length) {
    T2.info(`\uD83D\uDD27 Skills: ${manifest.dependencies.skills.map((s3) => s3.name).join(", ")}`);
  }
  if (manifest.dependencies.mcp?.length) {
    T2.info(`\uD83D\uDD0C MCP   : ${manifest.dependencies.mcp.map((m2) => m2.name).join(", ")}`);
  }
  if (manifest.dependencies.docker?.length) {
    T2.info(`\uD83D\uDC33 Docker: ${manifest.dependencies.docker.map((d2) => d2.service).join(", ")}`);
  }
  Fe("Pack 完成");
}
async function generateManifestDraft(agentDir, agentFiles) {
  const firstAgent = path.join(agentDir, agentFiles[0]);
  const parsed = import_gray_matter.default(fs.readFileSync(firstAgent, "utf8"));
  const agentName = path.basename(agentFiles[0], ".md");
  return {
    schemaVersion: SCHEMA_VERSION,
    packageId: `ddm.${agentName}`,
    version: "0.1.0",
    name: parsed.data.description ?? agentName,
    summary: "请填写 20-40 字的一句话说明",
    description: "请填写 80-160 字的适用场景、核心能力和主要产出说明",
    tags: ["请填写", "领域标签", "3-5个"],
    quickCommands: [
      {
        id: "start",
        label: "开始任务",
        prompt: "请填写用户点击后发送给 agent 的完整任务指令"
      }
    ],
    agents: agentFiles,
    dependencies: {},
    changeSummary: "初始版本"
  };
}
async function cmdUnpack(opts) {
  Ge("DDM Unpack");
  const zipPath = path.resolve(opts.zipPath);
  if (!fs.existsSync(zipPath)) {
    T2.error(`文件不存在: ${zipPath}`);
    process.exitCode = 1;
    return;
  }
  const s = J2();
  s.start("读取 zip 包...");
  const zip = await import_jszip.default.loadAsync(fs.readFileSync(zipPath));
  const manifestFile = zip.file("manifest.json");
  let manifest;
  try {
    if (!manifestFile)
      throw new Error("zip 包中缺少 manifest.json");
    manifest = parseManifest(await manifestFile.async("string"));
  } catch (e2) {
    s.stop("manifest.json 验证失败", 1);
    T2.error(String(e2));
    process.exitCode = 1;
    return;
  }
  s.stop(`已读取 ${manifest.name} v${manifest.version}`);
  if (!opts.yes) {
    T2.info(`\uD83D\uDCE6 包 ID : ${manifest.packageId}`);
    T2.info(`\uD83D\uDCCC 版本  : ${manifest.version}`);
    T2.info(`\uD83D\uDCDD 简介  : ${manifest.summary}`);
    const deps2 = manifest.dependencies;
    if (deps2.skills?.length)
      T2.info(`\uD83D\uDD27 将安装 Skills: ${deps2.skills.map((s2) => s2.name).join(", ")}`);
    if (deps2.mcp?.length)
      T2.info(`\uD83D\uDD0C 将配置 MCP: ${deps2.mcp.map((m2) => m2.name).join(", ")}`);
    if (deps2.docker?.length)
      T2.info(`\uD83D\uDC33 将启动 Docker: ${deps2.docker.map((d2) => d2.service).join(", ")}`);
    if (deps2.envVars?.filter((e2) => e2.required).length) {
      T2.info(`\uD83D\uDD11 需要填写环境变量: ${deps2.envVars.filter((e2) => e2.required).map((e2) => e2.key).join(", ")}`);
    }
    const ok = await ke({ message: "确认导入这个 agent 吗？" });
    if (!ok) {
      T2.info("已取消");
      return;
    }
  }
  const xdgConfig = process.env.XDG_CONFIG_HOME ?? path.join(os.homedir(), ".config");
  const targetDir = opts.target ? path.resolve(opts.target) : path.join(xdgConfig, "opencode");
  const opencodeDir = opts.target ? path.join(targetDir, ".opencode") : targetDir;
  fs.mkdirSync(opencodeDir, { recursive: true });
  const s1 = J2();
  s1.start("复制 agent 文件...");
  let copied = 0;
  for (const agentPath of manifest.agents) {
    const file = zip.file(agentPath);
    if (!file) {
      T2.warn(`manifest 中声明的文件不在 zip 内: ${agentPath}`);
      continue;
    }
    const dest = path.resolve(opencodeDir, agentPath);
    if (!dest.startsWith(path.resolve(opencodeDir) + path.sep) && dest !== path.resolve(opencodeDir)) {
      T2.warn(`跳过非法路径（路径遍历）: ${agentPath}`);
      continue;
    }
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    fs.writeFileSync(dest, await file.async("string"), "utf8");
    copied++;
  }
  s1.stop(`已复制 ${copied} 个 agent 文件到 ${opencodeDir}/agent/`);
  const deps = manifest.dependencies;
  if (opts.skipDeps) {
    T2.warn("已跳过 dependencies 安装和配置");
    T2.success(`${manifest.name} 导入完成！`);
    T2.info(`重启 OpenCode 后即可使用 @${path.basename(manifest.agents[0], ".md")} 调用此 agent`);
    Fe("Unpack 完成");
    return;
  }
  if (deps.skills && deps.skills.length > 0) {
    for (const skill of deps.skills) {
      const s2 = J2();
      s2.start(`安装 skill: ${skill.name}...`);
      const r = await runCommand(skill.installCommand);
      if (r.ok) {
        s2.stop(`✓ ${skill.name}`);
      } else {
        s2.stop(`✗ ${skill.name} 安装失败`, 1);
        T2.warn(`可手动运行: ${skill.installCommand}`);
        if (!skill.required)
          T2.warn("（此 skill 非必须，可跳过）");
      }
    }
  }
  if (deps.mcp && deps.mcp.length > 0) {
    const s3 = J2();
    s3.start("合并 MCP 配置...");
    const configPath = opts.target ? path.join(opencodeDir, "opencode.jsonc") : resolveOpencodeConfig();
    mergeJsonc(configPath, (obj) => {
      const mcp = obj.mcp ?? {};
      for (const m2 of deps.mcp) {
        if (mcp[m2.name]) {
          continue;
        }
        if (m2.type === "local") {
          mcp[m2.name] = {
            type: "local",
            command: m2.command,
            enabled: true
          };
        } else {
          mcp[m2.name] = {
            type: "remote",
            url: m2.url,
            headers: m2.headers ?? {},
            enabled: true
          };
        }
      }
      obj.mcp = mcp;
    });
    s3.stop(`已更新 ${configPath}`);
  }
  if (deps.docker && deps.docker.length > 0) {
    for (const docker of deps.docker) {
      const s4 = J2();
      s4.start(`启动 Docker 服务: ${docker.service}...`);
      const check = await runCommand(`docker ps -q -f name=${docker.service}`);
      if (check.ok) {
        s4.stop(`${docker.service} 已在运行，跳过`);
        continue;
      }
      const r = await runCommand(docker.startCommand);
      if (r.ok) {
        s4.stop(`✓ ${docker.service} 已启动`);
        if (docker.healthCheck) {
          T2.info(`健康检查: ${docker.healthCheck}`);
        }
      } else {
        s4.stop(`✗ ${docker.service} 启动失败`, 1);
        T2.warn(`可手动运行: ${docker.startCommand}`);
        if (!docker.required)
          T2.warn("（此服务非必须，可跳过）");
        else
          T2.error(`此服务是必须的，agent 可能无法正常工作`);
      }
    }
  }
  if (deps.apps && deps.apps.length > 0) {
    const platform2 = os.platform();
    const platformKey = platform2 === "darwin" ? "macos" : platform2 === "win32" ? "windows" : "linux";
    const relevantApps = deps.apps.filter((a) => a.platform.includes(platformKey));
    if (relevantApps.length > 0) {
      T2.warn("以下应用需要手动安装：");
      for (const app of relevantApps) {
        T2.warn(`  ${app.required ? "[必须]" : "[可选]"} ${app.name}: ${app.installUrl}`);
        T2.warn(`         ${app.description}`);
      }
    }
  }
  if (deps.envVars && deps.envVars.length > 0) {
    T2.info("");
    T2.info("以下环境变量需要配置：");
    const envLines = [];
    for (const ev of deps.envVars) {
      if (opts.yes) {
        T2.warn(`  ${ev.required ? "[必须]" : "[可选]"} ${ev.key}`);
        T2.info(`         ${ev.description}`);
        if (ev.example)
          T2.info(`         示例: ${ev.example}`);
        envLines.push(`${ev.key}=`);
      } else {
        T2.info(`  ${ev.required ? "【必填】" : "【可选】"} ${ev.key}`);
        T2.info(`         ${ev.description}`);
        if (ev.example)
          T2.info(`         示例: ${ev.example}`);
        if (ev.required) {
          const val = await et({
            message: `请输入 ${ev.key}`,
            placeholder: ev.example ?? ""
          });
          if (val && typeof val === "string") {
            envLines.push(`${ev.key}=${val}`);
          }
        } else {
          envLines.push(`# ${ev.key}=  # ${ev.description}`);
        }
      }
    }
    if (envLines.length > 0) {
      const envPath = path.join(opencodeDir, ".env");
      const existing = readFileSafe(envPath) ?? "";
      const toAdd = envLines.filter((line) => {
        const key = line.split("=")[0].replace(/^#\s*/, "");
        return !existing.includes(key + "=");
      });
      if (toAdd.length > 0) {
        fs.appendFileSync(envPath, `
` + toAdd.join(`
`) + `
`, "utf8");
        T2.info(`环境变量已追加到 ${envPath}`);
      }
    }
  }
  T2.info("");
  T2.success(`${manifest.name} 导入完成！`);
  T2.info(`重启 OpenCode 后即可使用 @${path.basename(manifest.agents[0], ".md")} 调用此 agent`);
  Fe("Unpack 完成");
}
async function readManifestFromZip(zipPath) {
  const zip = await import_jszip.default.loadAsync(fs.readFileSync(path.resolve(zipPath)));
  const manifestFile = zip.file("manifest.json");
  if (!manifestFile)
    throw new Error("zip 包中缺少 manifest.json");
  return parseManifest(await manifestFile.async("string"));
}
