import * as fs6 from "node:fs";
import * as path3 from "node:path";
import * as os3 from "node:os";
import * as http from "node:http";
import * as crypto from "node:crypto";
var PLATFORM_WEB_BASE_URL = process.env.PLATFORM_WEB_BASE_URL ?? "https://www.bothub.run";
var SUPABASE_URL = process.env.SUPABASE_URL ?? "https://kemfhphqsaxooafdmivq.supabase.co";
var SUPABASE_ANON_KEY = process.env.SUPABASE_ANON_KEY ?? "sb_publishable_bMXQDnIXXnLZ_qqqKup3Ug_SwHbbu1F";
var SUPABASE_FUNCTIONS_URL = `${SUPABASE_URL}/functions/v1`;
var OAUTH_CALLBACK_PORT = 19877;
var OAUTH_CALLBACK_PATH = "/api/platform-auth/callback";
var DDM_AUTH_FILE = path3.join(os3.homedir(), ".config", "ddm", "auth.json");
function base64UrlEncode(buf) {
  return buf.toString("base64").replaceAll("+", "-").replaceAll("/", "_").replace(/=+$/g, "");
}
function createCodeChallenge(verifier) {
  return base64UrlEncode(crypto.createHash("sha256").update(verifier).digest());
}
function createRandomToken(byteLength = 32) {
  return base64UrlEncode(crypto.randomBytes(byteLength));
}
function readSession() {
  try {
    return JSON.parse(fs6.readFileSync(DDM_AUTH_FILE, "utf8"));
  } catch {
    return null;
  }
}
function writeSession(session) {
  fs6.mkdirSync(path3.dirname(DDM_AUTH_FILE), { recursive: true, mode: 448 });
  fs6.writeFileSync(DDM_AUTH_FILE, JSON.stringify(session, null, 2), { encoding: "utf8", mode: 384 });
}
function resolveGlobalOpencodeConfig() {
  const xdgConfig = process.env.XDG_CONFIG_HOME ?? path3.join(os3.homedir(), ".config");
  return path3.join(xdgConfig, "opencode", "opencode.json");
}
function mergeJson(filePath, patch) {
  let raw = "{}";
  try {
    raw = fs6.readFileSync(filePath, "utf8");
    raw = raw.replace(/\/\/[^\n]*/g, "");
  } catch {}
  let obj;
  try {
    obj = JSON.parse(raw);
  } catch {
    obj = {};
  }
  patch(obj);
  fs6.mkdirSync(path3.dirname(filePath), { recursive: true });
  fs6.writeFileSync(filePath, JSON.stringify(obj, null, 2), "utf8");
}
async function supabaseFetch(path4, accessToken, init = {}) {
  const url = `${SUPABASE_FUNCTIONS_URL}${path4}`;
  const resp = await fetch(url, {
    ...init,
    headers: {
      "content-type": "application/json",
      apikey: SUPABASE_ANON_KEY,
      authorization: `Bearer ${accessToken}`,
      ...init.headers ?? {}
    }
  });
  if (!resp.ok) {
    const text = await resp.text().catch(() => "");
    throw new Error(`${resp.status} ${resp.statusText}: ${text}`);
  }
  if (resp.status === 204)
    return;
  return resp.json();
}
async function supabasePublicFetch(path4, init = {}) {
  const url = `${SUPABASE_FUNCTIONS_URL}${path4}`;
  const resp = await fetch(url, {
    ...init,
    headers: {
      "content-type": "application/json",
      apikey: SUPABASE_ANON_KEY,
      ...init.headers ?? {}
    }
  });
  if (!resp.ok) {
    const text = await resp.text().catch(() => "");
    throw new Error(`${resp.status} ${resp.statusText}: ${text}`);
  }
  return resp.json();
}
async function cmdLogin() {
  Ge("DDM Login");
  const existing = readSession();
  if (existing) {
    T2.info(`已登录: ${existing.user.email}`);
    const { confirm } = await Promise.resolve().then(() => (init_dist2(), exports_dist));
    const relogin = await confirm({ message: "重新登录？" });
    if (!relogin) {
      Fe("保持当前登录状态");
      return;
    }
  }
  const state = createRandomToken(24);
  const codeVerifier = createRandomToken(32);
  const codeChallenge = createCodeChallenge(codeVerifier);
  const authFlowId = `auth-${createRandomToken(12)}`;
  const redirectUri = `http://127.0.0.1:${OAUTH_CALLBACK_PORT}${OAUTH_CALLBACK_PATH}`;
  const loginUrl = `${PLATFORM_WEB_BASE_URL}/desktop-auth?${new URLSearchParams({
    auth_flow_id: authFlowId,
    state,
    redirect_uri: redirectUri,
    code_challenge: codeChallenge
  }).toString()}`;
  const s = J2();
  s.start("等待浏览器授权...");
  const code = await new Promise((resolve6, reject) => {
    const server = http.createServer((req, res) => {
      if (!req.url?.startsWith(OAUTH_CALLBACK_PATH))
        return;
      const url = new URL(req.url, `http://127.0.0.1:${OAUTH_CALLBACK_PORT}`);
      const returnedState = url.searchParams.get("state");
      const returnedCode = url.searchParams.get("code");
      res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
      if (returnedState !== state) {
        res.end(`<html><body style="font-family:sans-serif;text-align:center;padding:60px">
          <h2>❌ 登录失败</h2><p>state 校验失败，请重试。</p></body></html>`);
        server.close();
        reject(new Error("OAuth state 不匹配"));
        return;
      }
      if (!returnedCode) {
        res.end(`<html><body style="font-family:sans-serif;text-align:center;padding:60px">
          <h2>❌ 登录失败</h2><p>缺少授权码，请重试。</p></body></html>`);
        server.close();
        reject(new Error("缺少 code 参数"));
        return;
      }
      res.end(`<html><body style="font-family:sans-serif;text-align:center;padding:60px">
        <h2>✅ 登录成功</h2>
        <p>可以关闭这个窗口，回到终端继续操作。</p>
      </body></html>`);
      server.close();
      resolve6(returnedCode);
    });
    server.listen(OAUTH_CALLBACK_PORT, "127.0.0.1", () => {
      Promise.resolve().then(() => (init_open(), exports_open)).then(({ default: open2 }) => open2(loginUrl)).catch(() => {
        T2.warn(`请手动打开浏览器访问: ${loginUrl}`);
      });
    });
    server.on("error", reject);
    setTimeout(() => {
      server.close();
      reject(new Error("登录超时（3分钟），请重试"));
    }, 180000);
  }).catch((e2) => {
    s.stop("登录失败", 1);
    throw e2;
  });
  s.stop("已收到授权码");
  const s2 = J2();
  s2.start("换取平台 session...");
  const exchangeResult = await supabasePublicFetch("/exchange-desktop-auth", {
    method: "POST",
    body: JSON.stringify({
      code,
      redirect_uri: redirectUri,
      code_verifier: codeVerifier
    })
  }).catch((e2) => {
    s2.stop("换取 session 失败", 1);
    throw e2;
  });
  const otpResp = await fetch(`${SUPABASE_URL}/auth/v1/verify`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
      apikey: SUPABASE_ANON_KEY
    },
    body: JSON.stringify({
      email: exchangeResult.auth_otp.email,
      token: exchangeResult.auth_otp.token,
      type: "email"
    })
  });
  if (!otpResp.ok) {
    s2.stop("OTP 验证失败", 1);
    T2.error(await otpResp.text());
    process.exitCode = 1;
    return;
  }
  const otpData = await otpResp.json();
  const session = {
    platformWebBaseUrl: PLATFORM_WEB_BASE_URL,
    platformApiBaseUrl: `${new URL(PLATFORM_WEB_BASE_URL).origin}/api`,
    user: exchangeResult.user,
    accessToken: otpData.access_token,
    refreshToken: otpData.refresh_token,
    savedAt: new Date().toISOString()
  };
  writeSession(session);
  s2.stop(`已登录: ${session.user.email}`);
  const s3 = J2();
  s3.start("获取平台服务凭证...");
  const instancesResp = await fetch(`${SUPABASE_URL}/rest/v1/openclaw_service_instances?select=id,name&limit=5`, {
    headers: {
      apikey: SUPABASE_ANON_KEY,
      authorization: `Bearer ${session.accessToken}`
    }
  });
  if (!instancesResp.ok) {
    s3.stop("查询服务实例失败", 1);
    T2.error(`HTTP ${instancesResp.status}: ${await instancesResp.text()}`);
    process.exitCode = 1;
    return;
  }
  const instances = await instancesResp.json();
  if (instances.length === 0) {
    s3.stop("未找到服务实例", 1);
    T2.error("你的账号下没有服务实例，请先在 bothub.run 上创建一个实例后再登录");
    process.exitCode = 1;
    return;
  }
  const instanceId = instances[0].id;
  T2.info(`使用实例: ${instances[0].name} (${instanceId})`);
  const serviceTokenResp = await supabaseFetch("/issue-platform-service-token", session.accessToken, {
    method: "POST",
    body: JSON.stringify({
      instance_id: instanceId,
      name: "DDM CLI",
      scopes: ["llm:*", "service:*"]
    })
  }).catch((e2) => {
    s3.stop("获取服务凭证失败", 1);
    throw e2;
  });
  const serviceToken = serviceTokenResp.token;
  const endpointsResp = await supabasePublicFetch("/get-platform-service-endpoints", {
    method: "POST",
    headers: { authorization: `Bearer ${serviceToken}` },
    body: JSON.stringify({ environment: "prod" })
  }).catch((e2) => {
    s3.stop("获取服务地址失败", 1);
    throw e2;
  });
  const endpoints = endpointsResp.endpoints.map((row) => ({
    serviceId: row.service_id,
    protocol: row.protocol,
    baseUrl: row.base_url.replace(/\/+$/, ""),
    priority: row.priority ?? 100,
    weight: row.weight ?? 100
  }));
  const bestEndpoint = (serviceId) => endpoints.filter((e2) => e2.serviceId === serviceId).sort((a, b2) => b2.priority - a.priority || (b2.weight ?? 100) - (a.weight ?? 100))[0];
  const llmEndpoint = bestEndpoint("llm.openai-compatible.default");
  const imageEndpoint = bestEndpoint("image.openai-compatible.default");
  s3.stop("服务地址获取成功");
  const s4 = J2();
  s4.start("写入 OpenCode provider 配置...");
  const opencodeConfig = resolveGlobalOpencodeConfig();
  mergeJson(opencodeConfig, (obj) => {
    const providers = obj.provider ?? {};
    if (llmEndpoint) {
      providers["ddm"] = {
        name: "DDM",
        npm: "@ai-sdk/openai-compatible",
        options: {
          apiKey: serviceToken,
          baseURL: llmEndpoint.baseUrl
        },
        models: {
          "ddm-auto": {
            name: "DDM Auto",
            attachment: true,
            tool_call: true
          }
        }
      };
    }
    obj.provider = providers;
    if (llmEndpoint) {
      obj.model = "ddm/ddm-auto";
    }
    const mcp = obj.mcp ?? {};
    if (mcp["ddm-image"] && typeof mcp["ddm-image"] === "object") {
      const mcpEntry = mcp["ddm-image"];
      mcpEntry.environment = {
        ...mcpEntry.environment ?? {},
        DDM_TOKEN: serviceToken,
        ...imageEndpoint ? { DDM_IMAGE_API_URL: `${imageEndpoint.baseUrl}/images` } : {}
      };
    }
    obj.mcp = mcp;
  });
  s4.stop(`已更新 ${opencodeConfig}`);
  writeSession({
    ...session,
    serviceToken,
    llmBaseUrl: llmEndpoint?.baseUrl ?? null,
    imageApiUrl: imageEndpoint ? `${imageEndpoint.baseUrl}/images` : null
  });
  T2.info("");
  T2.success("登录完成！");
  T2.info(`用户    : ${session.user.email}`);
  if (llmEndpoint)
    T2.info(`LLM     : ${llmEndpoint.baseUrl}`);
  if (imageEndpoint)
    T2.info(`图像    : ${imageEndpoint.baseUrl}/images`);
  T2.info(`配置    : ${opencodeConfig}`);
  T2.info(`凭证    : ${DDM_AUTH_FILE}`);
  Fe("Done");
}
async function cmdSetup(opts = {}) {
  if (!opts.silent)
    Ge("DDM Setup");
  const platform4 = os3.platform();
  const ddmBin = process.execPath.endsWith("ddm") ? process.execPath : await findDdmBin();
  if (platform4 === "darwin") {
    await setupMacOS(ddmBin, opts.silent ?? false);
  } else if (platform4 === "linux") {
    await setupLinux(ddmBin, opts.silent ?? false);
  } else if (platform4 === "win32") {
    await setupWindows(ddmBin, opts.silent ?? false);
  } else {
    T2.warn(`不支持的平台: ${platform4}，请手动注册 ddm:// 协议`);
  }
  if (!opts.silent)
    Fe("Setup 完成");
}
async function findDdmBin() {
  const { execSync } = await import("node:child_process");
  try {
    return execSync("which ddm", { encoding: "utf8" }).trim();
  } catch {
    return "ddm";
  }
}
async function setupMacOS(ddmBin, silent) {
  const handlerScript = path3.join(os3.homedir(), ".local", "bin", "ddm-protocol-handler.sh");
  const plistPath = path3.join(os3.homedir(), "Library", "LaunchAgents", "ai.ddm.protocol-handler.plist");
  fs6.mkdirSync(path3.dirname(handlerScript), { recursive: true });
  fs6.writeFileSync(handlerScript, `#!/bin/bash
# DDM protocol handler: ddm://<path>
"${ddmBin}" import "$1"
`, { mode: 493 });
  const plist = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.ddm.protocol-handler</string>
  <key>ProgramArguments</key>
  <array>
    <string>${handlerScript}</string>
  </array>
  <key>StandardOutPath</key>
  <string>${os3.homedir()}/.config/ddm/protocol-handler.log</string>
  <key>StandardErrorPath</key>
  <string>${os3.homedir()}/.config/ddm/protocol-handler.log</string>
</dict>
</plist>`;
  fs6.mkdirSync(path3.dirname(plistPath), { recursive: true });
  fs6.writeFileSync(plistPath, plist, "utf8");
  if (!silent) {
    T2.success(`已写入 protocol handler: ${handlerScript}`);
    T2.info(`LaunchAgent: ${plistPath}`);
    T2.warn("macOS 的 URI scheme 注册需要一个 .app bundle，建议使用 DDM Desktop 应用获得完整的协议支持。");
    T2.info("当前已配置 shell handler，在 Terminal 中执行 ddm import ddm://... 可正常工作。");
  }
}
async function setupLinux(ddmBin, silent) {
  const desktopFile = path3.join(os3.homedir(), ".local", "share", "applications", "ddm-protocol-handler.desktop");
  const content = `[Desktop Entry]
Name=DDM Protocol Handler
Exec=${ddmBin} import %u
Type=Application
NoDisplay=true
MimeType=x-scheme-handler/ddm;
`;
  fs6.mkdirSync(path3.dirname(desktopFile), { recursive: true });
  fs6.writeFileSync(desktopFile, content, "utf8");
  const { execSync } = await import("node:child_process");
  try {
    execSync(`xdg-mime default ddm-protocol-handler.desktop x-scheme-handler/ddm`, { stdio: "pipe" });
    execSync(`update-desktop-database ${path3.dirname(desktopFile)}`, { stdio: "pipe" });
    if (!silent)
      T2.success(`已注册 ddm:// 协议 (${desktopFile})`);
  } catch {
    if (!silent) {
      T2.warn(`已写入 ${desktopFile}`);
      T2.warn("请手动运行: xdg-mime default ddm-protocol-handler.desktop x-scheme-handler/ddm");
    }
  }
}
async function setupWindows(ddmBin, silent) {
  const { execSync } = await import("node:child_process");
  const regScript = `
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\\Software\\Classes\\ddm]
@="URL:DDM Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\\Software\\Classes\\ddm\\shell]

[HKEY_CURRENT_USER\\Software\\Classes\\ddm\\shell\\open]

[HKEY_CURRENT_USER\\Software\\Classes\\ddm\\shell\\open\\command]
@="\\"${ddmBin.replace(/\\/g, "\\\\")}" import \\"%1\\""
`;
  const regFile = path3.join(os3.tmpdir(), "ddm-protocol.reg");
  fs6.writeFileSync(regFile, regScript, "utf16le");
  try {
    execSync(`regedit /s "${regFile}"`, { stdio: "pipe" });
    if (!silent)
      T2.success("已注册 ddm:// 协议到 Windows 注册表");
  } catch (e2) {
    if (!silent) {
      T2.warn(`写入注册表失败: ${String(e2)}`);
      T2.info(`请手动导入: ${regFile}`);
    }
  }
}
async function resolveImportZip(input, quiet = false) {
  if (!input.startsWith("ddm://"))
    return { zipPath: input, cleanup: () => {} };
  let pkgUrl;
  try {
    const parsed = new URL(input);
    pkgUrl = parsed.searchParams.get("pkg") ?? parsed.searchParams.get("url") ?? "";
    if (!pkgUrl)
      throw new Error("缺少 pkg/url 参数");
  } catch (e2) {
    throw new Error(`无效的 ddm:// URL: ${String(e2)}`);
  }
  const parsedUrl = new URL(pkgUrl);
  if (parsedUrl.protocol !== "https:")
    throw new Error(`只允许 https:// 协议，拒绝: ${parsedUrl.protocol}`);
  const s = quiet ? null : J2();
  s?.start(`下载 agent 包: ${pkgUrl}`);
  const resp = await fetch(pkgUrl);
  if (!resp.ok) {
    s?.stop(`下载失败: HTTP ${resp.status}`, 1);
    throw new Error(`下载失败: HTTP ${resp.status}`);
  }
  const tmpFile = path3.join(os3.tmpdir(), `ddm-import-${Date.now()}.zip`);
  fs6.writeFileSync(tmpFile, Buffer.from(await resp.arrayBuffer()));
  s?.stop(`已下载到临时文件: ${tmpFile}`);
  return {
    zipPath: tmpFile,
    cleanup: () => {
      try {
        fs6.unlinkSync(tmpFile);
      } catch {}
    }
  };
}
async function cmdPreview(input) {
  try {
    const { readManifestFromZip: readManifestFromZip2 } = await Promise.resolve().then(() => (init_pack(), exports_pack));
    const resolved = await resolveImportZip(input, true);
    try {
      process.stdout.write(`${JSON.stringify(await readManifestFromZip2(resolved.zipPath), null, 2)}
`);
    } finally {
      resolved.cleanup();
    }
  } catch (e2) {
    T2.error(String(e2));
    process.exitCode = 1;
  }
}
async function cmdImport(input, opts = {}) {
  const { cmdUnpack: cmdUnpack2 } = await Promise.resolve().then(() => (init_pack(), exports_pack));
  if (input.startsWith("ddm://")) {
    Ge("DDM Import");
    try {
      const resolved = await resolveImportZip(input);
      try {
        Fe("下载完成，开始导入...");
        await cmdUnpack2({ zipPath: resolved.zipPath, target: opts.target, yes: opts.yes, skipDeps: opts.skipDeps });
      } finally {
        resolved.cleanup();
      }
    } catch (e2) {
      T2.error(String(e2));
      process.exitCode = 1;
    }
    return;
  }
  await cmdUnpack2({ zipPath: input, target: opts.target, yes: opts.yes, skipDeps: opts.skipDeps });
}

// src/index.ts
yargs_default(hideBin(process.argv)).scriptName("ddm").usage("$0 <command> [options]").command("pack <agent-dir>", "将 agent 目录打包为 zip 发布包", (y) => y.positional("agent-dir", {
  type: "string",
  describe: "包含 agent/*.md 和 manifest.json 的目录",
  demandOption: true
}).option("out", {
  alias: "o",
  type: "string",
  describe: "输出 zip 文件路径（默认按 packageId-version.zip 命名）"
}), async (args) => {
  await cmdPack({
    agentDir: args["agent-dir"],
    out: args.out
  });
}).command("unpack <zip>", "从 zip 包还原 agent 到 OpenCode 执行环境", (y) => y.positional("zip", {
  type: "string",
  describe: "agent zip 文件路径",
  demandOption: true
}).option("target", {
  alias: "t",
  type: "string",
  describe: "目标目录（默认为当前目录，.opencode/ 会在此创建）"
}).option("yes", {
  alias: "y",
  type: "boolean",
  default: false,
  describe: "跳过确认提示，直接导入"
}), async (args) => {
  await cmdUnpack({
    zipPath: args.zip,
    target: args.target,
    yes: args.yes
  });
}).command("login", "登录 DDM 平台，获取 token 并写入 opencode.jsonc provider 配置", () => {}, async () => {
  await cmdLogin();
}).command("setup", "注册 ddm:// 协议 handler（使网站导入按钮能拉起本工具）", (y) => y.option("protocol-only", {
  type: "boolean",
  default: false,
  describe: "仅注册协议，跳过其他配置"
}).option("silent", {
  type: "boolean",
  default: false,
  describe: "静默模式，不输出日志（postinstall 使用）"
}), async (args) => {
  await cmdSetup({
    protocolOnly: args["protocol-only"],
    silent: args.silent
  });
}).command("import <input>", "从 ddm:// 协议 URL 或本地 zip 文件导入 agent", (y) => y.positional("input", {
  type: "string",
  describe: "ddm://import?pkg=<url>、ddm://import-agent?url=<url> 或 /path/to/file.zip",
  demandOption: true
}).option("yes", {
  alias: "y",
  type: "boolean",
  default: false,
  describe: "跳过确认提示，直接导入"
}).option("target", {
  alias: "t",
  type: "string",
  describe: "目标目录（默认为全局 OpenCode 配置目录，指定后会在该目录创建 .opencode/）"
}).option("skip-deps", {
  type: "boolean",
  default: false,
  describe: "只恢复 agent 文件，跳过 dependencies 安装和配置（用于离线验证）"
}), async (args) => {
  await cmdImport(args.input, { target: args.target, yes: args.yes, skipDeps: args["skip-deps"] });
}).command("preview <input>", "读取 ddm:// 协议 URL 或本地 zip 文件中的 manifest.json", (y) => y.positional("input", {
  type: "string",
  describe: "ddm://import?pkg=<url>、ddm://import-agent?url=<url> 或 /path/to/file.zip",
  demandOption: true
}), async (args) => {
  await cmdPreview(args.input);
}).demandCommand(1, "请指定一个命令").help().alias("h", "help").version().alias("v", "version").strict().parse();
